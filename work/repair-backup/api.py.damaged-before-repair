                existing_member_ids = {m.user_id for m in (existing.members or [])}
                for user_id in member_ids:
                    if not user_id:
                        continue

                    if user_id in existing_member_ids:
                        existing_member = MsgRoomMember.query.filter_by(room_id=existing.id, user_id=user_id).first()
                        if existing_member and existing_member.left_at is not None:
                            # ?ш?????joined_at ??蹂댁〈?댁빞 怨쇨굅 硫붿떆吏 ?대젰??洹몃?濡?蹂댁씤??
                            # (listMessages 媛 created_at >= joined_at ?쇰줈 ?꾪꽣留곹븯誘濡?由ъ뀑?섎㈃ ?대젰???щ씪吏꾨떎)
                            existing_member.left_at = None
                            db.session.execute(text(
                                "UPDATE msg_room_member SET participant_status='ACTIVE', rejoin_allowed=1 WHERE id=:mid"
                            ), {'mid': existing_member.id})
                            existing_member.last_read_message_id = None
                            existing_member.last_read_at = None
                            existing_member.unread_count_cached = 0
                        continue

                    db.session.add(MsgRoomMember(
                        room_id=existing.id,
                        user_id=user_id,
                        member_role=payload.get('member_role', 'MEMBER'),
                    ))

                db.session.commit()
                existing = MsgRoom.query.options(joinedload(MsgRoom.members)).get(existing.id)
                return jsonify({
                    **existing.to_dict(include_members=True),
                    '_revived': revived,
                }), 200

        return jsonify({'error': 'duplicate direct_key or constraint violation'}), 400

    assigned_member_ids = []
    for user_id in member_ids:
        if not user_id or user_id in assigned_member_ids:
            continue
        member = MsgRoomMember(
            room_id=room.id,
            user_id=user_id,
            member_role='OWNER' if room_type == 'CHANNEL' and int(user_id) == int(created_by) else payload.get('member_role', 'MEMBER'),
        )
        db.session.add(member)
        assigned_member_ids.append(user_id)

    db.session.commit()
    room = MsgRoom.query.options(joinedload(MsgRoom.members)).get(room.id)
    return jsonify(room.to_dict(include_members=True)), 201


