def _as_bool(value: Any, default: bool = True) -> bool:
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    text_value = str(value).strip().lower()
    if text_value in ('1', 'true', 'yes', 'y', 'on'):
        return True
    if text_value in ('0', 'false', 'no', 'n', 'off'):
        return False
    return default


