@api_bp.route('/api/chat/rooms/<int:room_id>/messages', methods=['GET'])
def list_chat_messages(room_id: int):
    _get_room_or_404(room_id)
    include_deleted = request.args.get('include_deleted') in ('1', 'true', 'True')
    include_files = request.args.get('include_files') in ('1', 'true', 'True')
    page = max(request.args.get('page', default=1, type=int), 1)
    per_page = min(max(request.args.get('per_page', default=50, type=int), 1), 200)
    order = (request.args.get('order') or 'asc').lower()
    if order not in ('asc', 'desc'):
        order = 'asc'

    query = MsgMessage.query.filter(MsgMessage.room_id == room_id)

    viewer_user_id = request.args.get('viewer_user_id', type=int)
    if not viewer_user_id:
        viewer_user_id = _resolve_viewer_user_id_from_session()

    # If the viewer cannot be identified, do not leak any history.
    if not viewer_user_id:
        return jsonify({
            'items': [],
            'page': page,
            'pages': 0,
            'total': 0,
            'order': order,
        })

    viewer_member = (
        MsgRoomMember.query
        .filter(MsgRoomMember.room_id == room_id)
        .filter(MsgRoomMember.user_id == viewer_user_id)
        .filter(MsgRoomMember.left_at.is_(None))
        .first()
    )
    # If the viewer is not an active member, they must not see any history.
    if not viewer_member:
        return jsonify({
            'items': [],
            'page': page,
            'pages': 0,
            'total': 0,
            'order': order,
        })
    if viewer_member.joined_at:
        query = query.filter(MsgMessage.created_at >= viewer_member.joined_at)
    try:
        _room_lifecycle_ensure_schema()
        state_row = db.session.execute(text(
            "SELECT local_deleted_at FROM msg_user_room_state WHERE user_id=:uid AND room_id=:rid"
        ), {'uid': viewer_user_id, 'rid': room_id}).fetchone()
        local_deleted_at = _retention_coerce_datetime(state_row._mapping['local_deleted_at']) if state_row else None
        if local_deleted_at:
            query = query.filter(MsgMessage.created_at > local_deleted_at)
    except Exception:
        db.session.rollback()
    if not include_deleted:
        query = query.filter(MsgMessage.is_deleted.is_(False))
    if request.args.get('after_id'):
        query = query.filter(MsgMessage.id > request.args.get('after_id', type=int))
    if request.args.get('before_id'):
        query = query.filter(MsgMessage.id < request.args.get('before_id', type=int))

    ordering = (
        (MsgMessage.created_at.desc(), MsgMessage.id.desc())
        if order == 'desc'
        else (MsgMessage.created_at.asc(), MsgMessage.id.asc())
    )
    pagination = query.order_by(*ordering).paginate(page=page, per_page=per_page, error_out=False)

    items = [msg.to_dict() for msg in pagination.items]
    if include_files and items:
        msg_ids = [item['id'] for item in items if item.get('id')]
        if msg_ids:
            files = MsgFile.query.filter(MsgFile.message_id.in_(msg_ids)).order_by(MsgFile.id.asc()).all()
            grouped = {}
            for f in files:
                grouped.setdefault(f.message_id, []).append(f.to_dict())
            for item in items:
                item['files'] = grouped.get(item.get('id'), [])

    # ---- Pin (怨좎젙) ?쒖떆 ----
    if items:
        msg_ids_for_pin = [item['id'] for item in items if item.get('id')]
        pinned_ids = set()
        if msg_ids_for_pin:
            try:
                pinned_rows = (
                    MsgPinnedMessage.query
                    .filter(MsgPinnedMessage.room_id == room_id)
                    .filter(MsgPinnedMessage.message_id.in_(msg_ids_for_pin))
                    .all()
                )
                pinned_ids = {row.message_id for row in pinned_rows}
            except Exception:
                pinned_ids = set()
        for item in items:
            item['is_pinned'] = item.get('id') in pinned_ids

    # ---- ?대え吏 諛섏쓳 吏묎퀎 ----
    if items:
        msg_ids_for_reaction = [item['id'] for item in items if item.get('id')]
        reactions_by_msg: dict = {}
        if msg_ids_for_reaction:
            try:
                rows = (
                    MsgMessageReaction.query
                    .filter(MsgMessageReaction.message_id.in_(msg_ids_for_reaction))
                    .order_by(MsgMessageReaction.id.asc())
                    .all()
                )
                for r in rows:
                    bucket = reactions_by_msg.setdefault(r.message_id, {})
                    entry = bucket.setdefault(r.emoji, {
                        'emoji': r.emoji,
                        'count': 0,
                        'user_ids': [],
                        'mine': False,
                    })
                    entry['count'] += 1
                    entry['user_ids'].append(r.user_id)
                    if r.user_id == viewer_user_id:
                        entry['mine'] = True
            except Exception:
                reactions_by_msg = {}
        for item in items:
            agg = reactions_by_msg.get(item.get('id'), {})
            item['reactions'] = list(agg.values())

    # ---- Compute per-message unread count (how many other members haven't read each message) ----
    # Fetch all active members of this room (excluding the viewer).
    other_members = (
        MsgRoomMember.query
        .filter(MsgRoomMember.room_id == room_id)
        .filter(MsgRoomMember.left_at.is_(None))
        .filter(MsgRoomMember.user_id != viewer_user_id)
        .all()
    )
    total_others = len(other_members)
    if total_others > 0 and items:
        # Each other member's read horizon: messages with id <= last_read_message_id are "read".
        read_horizons = [m.last_read_message_id or 0 for m in other_members]
        for item in items:
            msg_id = item.get('id', 0)
            # Count how many other members have NOT read this message.
            unread_by = sum(1 for h in read_horizons if msg_id > h)
            item['unread_count'] = unread_by
    else:
        for item in items:
            item['unread_count'] = 0

    return jsonify({
        'items': items,
        'page': page,
        'pages': pagination.pages,
        'total': pagination.total,
        'order': order,
    })


def _build_message_snippet(text: str, keyword: str, radius: int = 40) -> str:
    """寃??寃곌낵 誘몃━蹂닿린 ?ㅻ땲???앹꽦. ?ㅼ썙??二쇰? ?띿뒪?몃쭔 諛섑솚."""
    if not text:
        return ''
    if not keyword:
        return text[:120]
    lower = text.lower()
    idx = lower.find(keyword.lower())
    if idx < 0:
        return text[:120]
    start = max(0, idx - radius)
    end = min(len(text), idx + len(keyword) + radius)
    snippet = text[start:end]
    if start > 0:
        snippet = '...' + snippet
    if end < len(text):
        snippet = snippet + '...'
    return snippet


