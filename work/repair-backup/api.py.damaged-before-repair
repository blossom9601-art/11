@api_bp.route('/api/release-notes/<path:version>', methods=['PUT'])
def update_release_note(version):
    """湲곗〈 由대━利??명듃瑜??섏젙?쒕떎."""
    base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
    rn_path = os.path.join(base_dir, 'release-notes.md')
    data = request.get_json(silent=True)
    if not data:
        return jsonify({'success': False, 'error': '?붿껌 ?곗씠?곌? ?놁뒿?덈떎.'}), 400

    new_version = str(data.get('new_version', version)).strip()
    items = data.get('items', [])
    if isinstance(items, str):
        items = [line.strip() for line in items.split('\n') if line.strip()]

    try:
        if not os.path.exists(rn_path):
            return jsonify({'success': False, 'error': '?뚯씪??李얠쓣 ???놁뒿?덈떎.'}), 404

        with open(rn_path, 'r', encoding='utf-8') as f:
            content = f.read()

        blocks = _parse_release_blocks(content)
        found = False
        for block in blocks:
            if block['version'] == version:
                block['version'] = new_version
                block['items'] = items
                found = True
                break
        if not found:
            return jsonify({'success': False, 'error': '?대떦 踰꾩쟾??李얠쓣 ???놁뒿?덈떎.'}), 404

        with open(rn_path, 'w', encoding='utf-8', newline='\n') as f:
            f.write(_blocks_to_md(blocks))
        _settings_log_api('踰꾩쟾愿由?, '由대━利덈끂???섏젙', version, new_version)
        return jsonify({'success': True})
    except Exception:
        logger.exception('Failed to update release note')
        return jsonify({'success': False, 'error': '由대━利??명듃 ?섏젙 ?ㅽ뙣'}), 500


