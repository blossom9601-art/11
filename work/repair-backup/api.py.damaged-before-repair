    if not zone_name:
        return jsonify({'error': 'zone_name is required'}), 400

    # zone_key ?먮룞 ?앹꽦: ?쒓? ?쒓굅 ??snake_case
    import unicodedata
    import re as _re
    raw_key = data.get('zone_key', '').strip()
    if not raw_key:
        # 怨듬갚 ??_, 鍮껦SCII ?쒓굅, ?뚮Ц??
        normalized = zone_name.replace(' ', '_').replace('\t', '_')
        ascii_key = ''.join(c for c in normalized if c.isascii() and (c.isalnum() or c == '_'))
        ascii_key = ascii_key.lower().strip('_')
        if not ascii_key:
            ascii_key = str(int(datetime.utcnow().timestamp()))
        raw_key = 'zone_' + ascii_key
    raw_key = _re.sub(r'_+', '_', raw_key).strip('_')

    # ??以묐났 諛⑹?
    existing = DcAccessZone.query.filter_by(zone_key=raw_key).first()
    if existing:
        if existing.is_deleted:
            existing.is_deleted = 0
            existing.zone_name = zone_name
            db.session.commit()
            return jsonify({
                'id': existing.id, 'zone_name': existing.zone_name,
                'zone_key': existing.zone_key, 'sort_order': existing.sort_order,
                'is_deleted': 0, 'created_at': existing.created_at,
            }), 200
        return jsonify({'error': 'zone_key already exists'}), 409

    max_order = db.session.query(func.max(DcAccessZone.sort_order)).scalar() or 0
    zone = DcAccessZone(
        zone_name=zone_name,
        zone_key=raw_key,
        sort_order=max_order + 1,
    )
    db.session.add(zone)
    db.session.commit()
    return jsonify({
        'id': zone.id, 'zone_name': zone.zone_name,
        'zone_key': zone.zone_key, 'sort_order': zone.sort_order,
