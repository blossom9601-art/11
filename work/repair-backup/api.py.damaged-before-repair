def _blog_comment_like_summaries(post_id: int) -> tuple[dict[int, int], set[int]]:
    """Return (totals_by_comment_id, liked_comment_ids_by_me) for a post."""
    totals: dict[int, int] = {}
    liked_by_me: set[int] = set()

    try:
        rows = (
            db.session.query(BlogCommentLike.comment_id, func.count(BlogCommentLike.id))
            .join(BlogComment, BlogComment.id == BlogCommentLike.comment_id)
            .filter(BlogComment.post_id == post_id, BlogComment.is_deleted == 0)
            .group_by(BlogCommentLike.comment_id)
            .all()
        )
        totals = {int(cid): int(cnt) for (cid, cnt) in rows if cid is not None}
    except Exception:
        totals = {}

    try:
        prof, err = _blog_require_current_user_profile()
    except Exception:
        prof, err = None, None
    if prof is not None and err is None:
        try:
            liked_rows = (
                db.session.query(BlogCommentLike.comment_id)
                .join(BlogComment, BlogComment.id == BlogCommentLike.comment_id)
                .filter(
                    BlogComment.post_id == post_id,
                    BlogComment.is_deleted == 0,
                    BlogCommentLike.created_by_user_id == prof.id,
                )
                .all()
            )
            liked_by_me = {int(r[0]) for r in liked_rows if r and r[0] is not None}
        except Exception:
            liked_by_me = set()

    return totals, liked_by_me


