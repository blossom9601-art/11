@api_bp.route('/api/work-groups/<int:group_id>/wrk/reports', methods=['GET'])
def list_work_group_wrk_reports(group_id: int):
    """Work-group scoped work report list.

    Work reports do not have a direct FK to work groups.
    We filter by the work group's code appearing in common text/json fields.
    """
    if not _wrk_report_table_ready():
        return jsonify({'success': False, 'message': 'DB 留덉씠洹몃젅?댁뀡???꾩슂?⑸땲?? (wrk_report)'}), 500

    limit = request.args.get('limit', default=200, type=int) or 200
    limit = max(1, min(limit, 1000))
    try:
        wg = svc_get_work_group(group_id)
        if not wg:
            return jsonify({'success': False, 'message': '??곸쓣 李얠쓣 ???놁뒿?덈떎.'}), 404
        group_code = (wg.get('group_code') or '').strip()
        if not group_code:
            return jsonify({'success': True, 'items': [], 'total': 0})

        needle = f"%{group_code.lower()}%"
        query = WrkReport.query.filter(WrkReport.is_deleted == 0)
        query = query.filter(
            or_(
                func.lower(func.ifnull(WrkReport.targets, '')).like(needle),
                func.lower(func.ifnull(WrkReport.target_pairs_json, '')).like(needle),
                func.lower(func.ifnull(WrkReport.service, '')).like(needle),
                func.lower(func.ifnull(WrkReport.business, '')).like(needle),
                func.lower(func.ifnull(WrkReport.payload_json, '')).like(needle),
            )
        )
        rows = query.order_by(WrkReport.start_datetime.desc(), WrkReport.id.desc()).limit(limit).all()
        return jsonify({'success': True, 'items': [_serialize_wrk_report_summary(r) for r in rows], 'total': len(rows)})
    except Exception:
        logger.exception('Failed to list work-group work reports id=%s', group_id)
        return jsonify({'success': False, 'message': '?묒뾽?대젰 議고쉶 以??ㅻ쪟媛 諛쒖깮?덉뒿?덈떎.'}), 500


