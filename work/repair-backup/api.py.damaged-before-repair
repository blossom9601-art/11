_EMAIL_BASIC_RE = re.compile(r'^[^@\s]+@[^@\s]+\.[^@\s]+$')


def _is_valid_basic_email(email: Optional[str]) -> bool:
    if email is None:
        return True
    token = str(email).strip()
    if not token:
        return True
    if len(token) > 254:
        return False
    return _EMAIL_BASIC_RE.fullmatch(token) is not None


