    if not _dc_access_system_tables_ready():
        return jsonify({'error': 'dc_access_system table not ready'}), 500

    row = DcAccessSystem.query.get(system_id)
    if not row or int(row.is_deleted or 0) == 1:
        return jsonify({'error': 'not found'}), 404

    data = request.get_json(silent=True) or {}
    updated_by = data.get('updated_by')
    if not updated_by:
        return jsonify({'error': 'updated_by is required'}), 400

    actor = UserProfile.query.get(updated_by)
    if not actor:
        return jsonify({'error': 'updated_by user not found'}), 400

    # Do not allow changing system_code (unique business key)
    if 'system_code' in data and (data.get('system_code') or '').strip() and (data.get('system_code') or '').strip() != row.system_code:
        return jsonify({'error': 'system_code cannot be changed'}), 400

    # Required fields can be updated but cannot be blank
    if 'business_status_code' in data:
        v = (data.get('business_status_code') or '').strip()
        if not v:
            return jsonify({'error': 'business_status_code cannot be blank'}), 400
        row.business_status_code = v
    if 'business_name' in data:
        v = (data.get('business_name') or '').strip()
        if not v:
            return jsonify({'error': 'business_name cannot be blank'}), 400
        row.business_name = v
    if 'system_name' in data:
        v = (data.get('system_name') or '').strip()
        if not v:
            return jsonify({'error': 'system_name cannot be blank'}), 400
        row.system_name = v

    # Optional fields
    optional_text_fields = [
        'system_ip',
        'manage_ip',
        'manufacturer_name',
        'system_model_name',
        'serial_number',
        'center_code',
        'system_location',
        'system_dept_code',
        'service_dept_code',
    ]
    for key in optional_text_fields:
        if key in data:
            row.__setattr__(key, (data.get(key) or '').strip() or None)
    if 'system_manager_id' in data:
        row.system_manager_id = data.get('system_manager_id') or None
    if 'service_manager_id' in data:
        row.service_manager_id = data.get('service_manager_id') or None
    if 'remark' in data:
        row.remark = data.get('remark') or None

    row.updated_at = datetime.utcnow().isoformat()
    row.updated_by = updated_by

    db.session.commit()
    return jsonify(_dc_access_system_to_dict(row))


