_ticket_tables_exist = False


def _ticket_tables_ready() -> bool:
    """Return True if svc_ticket and svc_ticket_file tables exist, auto-migrate new columns."""
    global _ticket_tables_exist
    if _ticket_tables_exist:
        return True
    try:
        import sqlalchemy as sa
        insp = sa.inspect(db.engine)
        if not (insp.has_table('svc_ticket') and insp.has_table('svc_ticket_file')):
            _ticket_tables_exist = False
            return False
        # Ensure new columns exist (idempotent migration)
        cols = {c['name'] for c in insp.get_columns('svc_ticket')}
        for col_name, col_def in [
            ('assignee_json', 'TEXT'),
            ('cleared', 'INTEGER NOT NULL DEFAULT 0'),
        ]:
            if col_name not in cols:
                try:
                    db.session.execute(db.text(f'ALTER TABLE svc_ticket ADD COLUMN {col_name} {col_def}'))
                    db.session.commit()
                except Exception:
                    db.session.rollback()
        _ticket_tables_exist = True
    except Exception:
        _ticket_tables_exist = False
    return bool(_ticket_tables_exist)


def _ticket_now_text() -> str:
    return datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')


def _ticket_payload() -> dict:
    if request.is_json:
        return request.get_json(silent=True) or {}
    # multipart/form-data or application/x-www-form-urlencoded
    return dict(request.form or {})


