def _dr_training_apply_payload(row: DrTraining, payload: dict, *, strict_required: bool) -> None:
    """Apply UI payload to ORM row.

    strict_required:
      - True for create
      - False for update/bulk-update (partial)
    """

    # Accept both UI keys and DB-ish keys.
    status = _s(payload, 'status') or _s(payload, 'training_status')
    train_date = _s(payload, 'train_date') or _s(payload, 'training_date')
    train_name = _s(payload, 'train_name') or _s(payload, 'training_name')
    train_type = _s(payload, 'train_type') or _s(payload, 'training_type')
    # NOTE: _s() maps blank strings to None. For result we need to distinguish:
    # - key missing: no change (on update)
    # - key present + blank: user explicitly cleared the field
    result_present = ('result' in payload) or ('training_result' in payload)
    result = None
    if 'result' in payload:
        raw = payload.get('result')
        result = '' if raw is None else str(raw).strip()
    elif 'training_result' in payload:
        raw = payload.get('training_result')
        result = '' if raw is None else str(raw).strip()

    if strict_required:
        if not status:
            raise ValueError('status is required')
        if not train_date:
            raise ValueError('train_date is required')
        if not train_name:
            raise ValueError('train_name is required')
        if not train_type:
            raise ValueError('train_type is required')
        if result is None or result == '':
            raise ValueError('result is required')

    if status is not None:
        if status not in _DR_TRAINING_ALLOWED_STATUS:
            raise ValueError('invalid status')
        row.training_status = status

    if train_type is not None:
        if train_type not in _DR_TRAINING_ALLOWED_TYPES:
            raise ValueError('invalid train_type')
        row.training_type = train_type

    if result_present:
        if result:
            if result not in _DR_TRAINING_ALLOWED_RESULTS:
                raise ValueError('invalid result')
            row.training_result = result
        else:
            # Allow clearing on update/bulk-update. (DB column is NOT NULL, so store as empty string.)
            if strict_required:
                raise ValueError('result is required')
            row.training_result = ''

    if train_name is not None:
        row.training_name = train_name

    if train_date is not None:
        year = _derive_year_from_ymd(train_date)
        if not year:
            raise ValueError('train_date must be YYYY-MM-DD')
        row.training_date = train_date
        row.training_year = int(year)

    if 'target_systems' in payload or 'target_system_count' in payload:
        raw = payload.get('target_systems', payload.get('target_system_count'))
        try:
            num = int(raw) if raw is not None and raw != '' else 0
        except Exception:
            raise ValueError('target_systems must be an integer')
        if num < 0:
            raise ValueError('target_systems must be >= 0')
        row.target_system_count = num

    if 'participant_count' in payload:
        raw = payload.get('participant_count')
        try:
            num = int(raw) if raw is not None and raw != '' else 0
        except Exception:
            raise ValueError('participant_count must be an integer')
        if num < 0:
            raise ValueError('participant_count must be >= 0')
        row.participant_count = num

    if 'orgs' in payload or 'participant_org' in payload:
        row.participant_org = _s(payload, 'orgs') or _s(payload, 'participant_org')

    if 'note' in payload or 'training_remark' in payload:
        row.training_remark = _s(payload, 'note') or _s(payload, 'training_remark')

    if 'recovery_time' in payload or 'recovery_time_text' in payload:
        raw_rt = _s(payload, 'recovery_time') or _s(payload, 'recovery_time_text')
        mins, text_val = _parse_recovery_time(raw_rt)
        row.recovery_time_minutes = mins
        row.recovery_time_text = text_val


