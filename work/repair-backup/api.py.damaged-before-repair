def _apply_ticket_fields(row: SvcTicket, payload: dict, actor_user_id: int, is_create: bool) -> None:
    # Field aliases for existing UI forms
    title = (payload.get('title') or '').strip()
    ticket_type = (payload.get('ticket_type') or payload.get('kind') or payload.get('type') or '').strip()
    category = (payload.get('category') or payload.get('task') or '').strip() or None
    priority = (payload.get('priority') or '').strip()
    status = (payload.get('status') or '').strip() or (row.status if not is_create else 'PENDING')
    target_object = (payload.get('target_object') or payload.get('target') or '').strip() or None
    due_at = (payload.get('due_at') or payload.get('due') or '').strip()
    detail = payload.get('detail')

    requester_user_id = _coerce_ticket_user_id(
        payload.get('requester_user_id') or payload.get('requester_id'),
        fallback=actor_user_id,
    )
    requester_dept_id = _coerce_positive_int(payload.get('requester_dept_id') or payload.get('requester_department_id'))
    assignee_user_id = _coerce_ticket_user_id(payload.get('assignee_user_id') or payload.get('assignee_id'))
    assignee_dept_id = _coerce_positive_int(payload.get('assignee_dept_id') or payload.get('assignee_department_id'))

    if is_create:
        if not title:
            raise ValueError('title? ?꾩닔?낅땲??')
        if not ticket_type:
            raise ValueError('ticket_type(?먮뒗 kind)???꾩닔?낅땲??')
        if not priority:
            raise ValueError('priority???꾩닔?낅땲??')
        if not due_at:
            raise ValueError('due_at(?먮뒗 due)???꾩닔?낅땲??')

        row.title = title
        row.ticket_type = ticket_type
        row.category = category
        row.priority = priority
        row.status = status
        row.requester_user_id = requester_user_id
        row.requester_dept_id = requester_dept_id
        row.assignee_user_id = assignee_user_id
        row.assignee_dept_id = assignee_dept_id
        row.target_object = target_object
        row.due_at = due_at
        row.detail = detail
        row.created_by_user_id = actor_user_id
    else:
        # Partial updates allowed
        if title:
            row.title = title
        if ticket_type:
            row.ticket_type = ticket_type
        if payload.get('category') is not None or payload.get('task') is not None:
            row.category = category
        if priority:
            row.priority = priority
        if payload.get('status') is not None:
            row.status = status
        if payload.get('requester_user_id') is not None or payload.get('requester_id') is not None:
            row.requester_user_id = requester_user_id
        if payload.get('requester_dept_id') is not None:
            row.requester_dept_id = requester_dept_id
        if payload.get('assignee_user_id') is not None or payload.get('assignee_id') is not None:
            row.assignee_user_id = assignee_user_id
        if payload.get('assignee_dept_id') is not None:
            row.assignee_dept_id = assignee_dept_id
        if payload.get('target_object') is not None or payload.get('target') is not None:
            row.target_object = target_object
        if due_at:
            row.due_at = due_at
        if payload.get('detail') is not None:
            row.detail = detail

        # Optional resolution fields
        if payload.get('resolved_at') is not None:
            row.resolved_at = (str(payload.get('resolved_at')).strip() or None)
        if payload.get('closed_at') is not None:
            row.closed_at = (str(payload.get('closed_at')).strip() or None)
        if payload.get('resolution_summary') is not None:
            row.resolution_summary = (str(payload.get('resolution_summary')).strip() or None)

        row.updated_at = _ticket_now_text()
        row.updated_by_user_id = actor_user_id

    # FK validation (after coerce)
    err = _validate_fk_user(row.requester_user_id, 'requester_user_id')
    if err:
        raise ValueError(err)
    err = _validate_fk_user(row.assignee_user_id, 'assignee_user_id')
    if err:
        raise ValueError(err)
    err = _validate_fk_user(row.created_by_user_id, 'created_by_user_id')
    if err:
        raise ValueError(err)
    err = _validate_fk_dept(row.requester_dept_id, 'requester_dept_id')
    if err:
        raise ValueError(err)
    err = _validate_fk_dept(row.assignee_dept_id, 'assignee_dept_id')
    if err:
        raise ValueError(err)

    # ?? Multi-assignee JSON handling ??
    assignee_json_raw = payload.get('assignee_json')
    if assignee_json_raw is not None:
        try:
            arr = json.loads(assignee_json_raw) if isinstance(assignee_json_raw, str) else assignee_json_raw
            if isinstance(arr, list):
                enriched = []
                first_user_id = None
                for a in arr:
                    name = (a.get('value') or a.get('name') or '').strip() if isinstance(a, dict) else str(a).strip()
                    display = a.get('display', name) if isinstance(a, dict) else name
                    dept = ''
                    uid = None
                    if name:
                        profile = UserProfile.query.filter_by(name=name).first()
                        if profile:
                            uid = profile.id
                            dept = profile.department or ''
                    enriched.append({'user_id': uid, 'name': name, 'dept': dept, 'display': display})
                    if uid and first_user_id is None:
                        first_user_id = uid
                row.assignee_json = json.dumps(enriched, ensure_ascii=False)
                if first_user_id and (is_create or row.assignee_user_id is None):
                    row.assignee_user_id = first_user_id
        except (ValueError, TypeError):
            pass

    # ?? Cleared flag ??
    if payload.get('cleared') is not None:
        row.cleared = 1 if _coerce_bool(payload.get('cleared'), default=False) else 0

    # ?? Auto-manage closed_at based on status ??
    if row.status == 'DONE' and not row.closed_at:
        row.closed_at = _ticket_now_text()
    elif row.status and row.status != 'DONE':
        row.closed_at = None


def _ticket_upload_files(ticket_id: int, actor_user_id: int) -> List[SvcTicketFile]:
    files = []
    try:
        files.extend(request.files.getlist('files'))
    except Exception:
        pass
    try:
        files.extend(request.files.getlist('attachments'))
    except Exception:
        pass
    files = [f for f in files if f and getattr(f, 'filename', None)]
    if not files:
        return []
    if len(files) > 10:
        raise ValueError('泥⑤? ?뚯씪? 理쒕? 10媛쒓퉴吏 ?낅줈?쒗븷 ???덉뒿?덈떎.')

    base_dir = os.path.join(current_app.instance_path, 'uploads', 'tickets', str(ticket_id))
    os.makedirs(base_dir, exist_ok=True)

    max_bytes = 20 * 1024 * 1024
    created: List[SvcTicketFile] = []
    for file in files:
        original = (file.filename or '').strip()
        safe = secure_filename(original)
        if not safe:
            continue
        if not _is_allowed_upload_file(safe):
            raise ValueError(f'?덉슜?섏? ?딅뒗 ?뚯씪 ?뺤떇?낅땲?? {safe}')
        stored = f"{uuid.uuid4().hex}_{safe}"
        abs_path = os.path.join(base_dir, stored)
        file.save(abs_path)

        try:
            size_bytes = os.path.getsize(abs_path)
        except OSError:
            size_bytes = None
        if size_bytes is not None and size_bytes > max_bytes:
            try:
                os.remove(abs_path)
            except OSError:
                pass
            raise ValueError('?뚯씪 ?⑸웾? 20MB ?댄븯留??낅줈?쒗븷 ???덉뒿?덈떎.')

        rel_path = os.path.join('uploads', 'tickets', str(ticket_id), stored).replace('\\', '/')
        rec = SvcTicketFile(
            ticket_id=ticket_id,
            file_path=rel_path,
            original_name=original,
            file_size=size_bytes,
            content_type=getattr(file, 'mimetype', None),
            uploaded_by_user_id=actor_user_id,
        )
        db.session.add(rec)
        created.append(rec)

    return created


