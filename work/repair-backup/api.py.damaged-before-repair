_LEASED_LINE_DIAGRAM_EXTS = {'.png', '.jpg', '.jpeg'}
_LEASED_LINE_DIAGRAM_MAX_BYTES = 10 * 1024 * 1024  # 10MB


def _leased_line_diagram_base_folder() -> str:
    folder = current_app.config.get('UPLOAD_FOLDER')
    if not folder:
        folder = os.path.join(current_app.instance_path, 'uploads')
    if not os.path.isabs(folder):
        folder = os.path.join(current_app.root_path, '..', folder)
    os.makedirs(folder, exist_ok=True)
    return folder


def _leased_line_diagram_folder() -> str:
    base = _leased_line_diagram_base_folder()
    folder = os.path.join(base, 'leased_line_diagrams')
    os.makedirs(folder, exist_ok=True)
    return folder


def _leased_line_diagram_abs_path(rel_path: Optional[str]) -> Optional[str]:
    if not rel_path:
        return None
    rel = str(rel_path).replace('\\', '/')
    rel = rel.lstrip('/')
    base = _leased_line_diagram_base_folder().replace('\\', '/')
    abs_path = os.path.join(base, rel).replace('\\', '/')
    if not abs_path.startswith(base):
        return None
    return abs_path


def _delete_file_safely(path: Optional[str]) -> None:
    if not path:
        return
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


def _leased_line_diagram_to_dict(row: Optional[NetLeasedLineDiagram]) -> Optional[dict]:
    if not row:
