@api_bp.route('/api/me/profile', methods=['GET', 'POST'])
def me_profile():
    """Get/Update current user's profile.

    Uses session['emp_no'] as identity and updates org_user(UserProfile).
    """
    emp_no = (session.get('emp_no') or '').strip()
    if not emp_no:
        raw_uid = session.get('user_id')
        raw_profile_id = session.get('user_profile_id') or session.get('profile_user_id')
        try:
            if raw_uid:
                auth_row = AuthUser.query.filter_by(id=int(raw_uid)).first()
                if auth_row and getattr(auth_row, 'emp_no', None):
                    emp_no = (auth_row.emp_no or '').strip()
        except Exception:
            emp_no = emp_no or ''

        if not emp_no:
            try:
                if raw_profile_id:
                    profile_row = UserProfile.query.filter_by(id=int(raw_profile_id)).first()
                    if profile_row and getattr(profile_row, 'emp_no', None):
                        emp_no = (profile_row.emp_no or '').strip()
            except Exception:
                emp_no = emp_no or ''

    if not emp_no:
        return jsonify({'success': False, 'message': '濡쒓렇?몄씠 ?꾩슂?⑸땲??'}), 401

    prof = UserProfile.query.filter_by(emp_no=emp_no).first()
    auth_user = AuthUser.query.filter_by(emp_no=emp_no).first()

    if request.method == 'GET':
        role = ((getattr(auth_user, 'role', '') if auth_user else '') or session.get('role') or '').strip()
        role_upper = role.upper()
        is_admin = role_upper == 'ADMIN' or _is_admin_session()
        if is_admin and not role:
            role = 'ADMIN'
            role_upper = 'ADMIN'
        merged = {
            'id': (int(prof.id) if prof and getattr(prof, 'id', None) else None),
            'emp_no': emp_no,
            'name': (prof.name if prof and prof.name else ''),
            'nickname': (prof.nickname if prof and prof.nickname else ''),
            'role': role_upper or role,
            'role_name': '愿由ъ옄' if is_admin else (role or ''),
            'is_admin': bool(is_admin),
            'admin': bool(is_admin),
            'department_id': (getattr(prof, 'department_id', None) if prof else None),
            'department': (prof.department if prof and prof.department else ''),
            'location': (getattr(prof, 'location', '') or '' if prof else ''),
            'ext_phone': (prof.ext_phone if prof and prof.ext_phone else ''),
            'mobile_phone': (prof.mobile_phone if prof and prof.mobile_phone else ''),
            'email': (prof.email if prof and prof.email else (auth_user.email if auth_user and auth_user.email else '')),
            'job': (prof.job if prof and prof.job else ''),
            'note': (prof.note if prof and prof.note else ''),
            'motto': (getattr(prof, 'motto', '') if prof and getattr(prof, 'motto', None) else ''),
            'profile_image': (prof.profile_image if prof and prof.profile_image else '/static/image/svg/profil/free-icon-bussiness-man.svg'),
        }
        return jsonify({'success': True, 'item': merged})

    payload = request.get_json(silent=True) or {}
    if not isinstance(payload, dict):
        return jsonify({'success': False, 'message': 'invalid_payload'}), 400

    if not prof:
        prof = UserProfile(emp_no=emp_no)
        db.session.add(prof)

    def _clean_text(val: Any, max_len: int = 255) -> str:
        if val is None:
            return ''
        if not isinstance(val, str):
            val = str(val)
        val = val.strip()
        if len(val) > max_len:
            val = val[:max_len]
        return val

    allowed_keys = {
        'nickname': ('nickname', 128),
        'department': ('department', 128),
        'location': ('location', 128),
        'ext_phone': ('ext_phone', 32),
        'mobile_phone': ('mobile_phone', 32),
        'email': ('email', 255),
        'job': ('job', 2000),
        'note': ('note', 2000),
        'motto': ('motto', 255),
        'profile_image': ('profile_image', 255),
    }

    changed = False
    for key, (attr, max_len) in allowed_keys.items():
        if key not in payload:
            continue
        val = _clean_text(payload.get(key), max_len=max_len)
        if key == 'email' and val and '@' not in val:
            return jsonify({'success': False, 'message': '?대찓???뺤떇???щ컮瑜댁? ?딆뒿?덈떎.'}), 400
        if key == 'profile_image' and val:
            # Accept a broad set of UI-provided formats and normalize to /static/... path.
            # Examples:
            # - https://host/static/image/svg/profil/001-boy.svg
            # - url("https://host/static/image/svg/profil/001-boy.svg")
            # - url('/static/image/svg/profil/001-boy.svg')
            norm = val
            if norm.startswith('http://') or norm.startswith('https://'):
                try:
                    parsed = urlparse(norm)
                    norm = (parsed.path or '').strip()
                except Exception:
                    norm = ''

            if norm.lower().startswith('url(') and norm.endswith(')'):
                norm = norm[4:-1].strip().strip('"\'')
                if norm.startswith('http://') or norm.startswith('https://'):
                    try:
                        parsed = urlparse(norm)
                        norm = (parsed.path or '').strip()
                    except Exception:
                        norm = ''

            if '/static/' in norm and not norm.startswith('/static/'):
                idx = norm.find('/static/')
                norm = norm[idx:]

            if not norm.startswith('/static/'):
                norm = '/static/image/svg/profil/free-icon-bussiness-man.svg'

            val = _clean_text(norm, max_len=max_len)

        if getattr(prof, attr) != val:
            setattr(prof, attr, val)
            changed = True

    # Keep department_id in sync when department name is edited.
    # UI sends department as free-text (datalist). If it matches org_department.dept_name, store FK.
    if 'department' in payload:
        dept_token = (prof.department or '').strip()
        resolved_dept_id = None
        if dept_token:
            try:
                dept_row = (
                    OrgDepartment.query
                    .filter(OrgDepartment.is_deleted.is_(False))
                    .filter(func.lower(func.trim(OrgDepartment.dept_name)) == dept_token.lower())
                    .first()
                )
                resolved_dept_id = int(dept_row.id) if dept_row else None
            except Exception:
                resolved_dept_id = None

        if getattr(prof, 'department_id', None) != resolved_dept_id:
            prof.department_id = resolved_dept_id
            changed = True

    if not changed:
        return jsonify({'success': True, 'item': {'emp_no': emp_no}})

    try:
        db.session.commit()
    except Exception as e:
        db.session.rollback()
        logger.exception('Failed to update me profile')
        return jsonify({'success': False, 'message': str(e)}), 500

    return jsonify({'success': True, 'item': {
        'emp_no': emp_no,
        'name': prof.name or '',
        'nickname': prof.nickname or '',
        'department_id': getattr(prof, 'department_id', None),
        'department': prof.department or '',
        'location': getattr(prof, 'location', '') or '',
        'ext_phone': prof.ext_phone or '',
        'mobile_phone': prof.mobile_phone or '',
        'email': prof.email or '',
        'job': prof.job or '',
        'note': prof.note or '',
        'motto': (getattr(prof, 'motto', '') or ''),
        'profile_image': prof.profile_image or '/static/image/svg/profil/free-icon-bussiness-man.svg',
    }})

