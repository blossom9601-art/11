def _require_lumina_gate_sync_token():
    secret = (os.environ.get('LUMINA_GATE_WEB_SYNC_SECRET') or '').strip()
    if not secret:
        return jsonify({'success': False, 'message': 'LUMINA_GATE_WEB_SYNC_SECRET 媛 ?ㅼ젙?섏? ?딆븘 ?숆린?붽? 鍮꾪솢?깊솕 ?곹깭?낅땲??'}), 503

    auth = request.headers.get('Authorization', '')
    tok = ''
    if auth.lower().startswith('bearer '):
        tok = auth[7:].strip()
    if not tok:
        tok = (request.headers.get('X-Lumina-Gate-Sync-Token') or '').strip()
    if not tok:
        return jsonify({'success': False, 'message': '?숆린???좏겙???꾩슂?⑸땲??'}), 401

    if len(tok) != len(secret):
        return jsonify({'success': False, 'message': '?좏슚?섏? ?딆? ?숆린???좏겙?낅땲??'}), 401

    if not hmac.compare_digest(tok, secret):
        return jsonify({'success': False, 'message': '?좏슚?섏? ?딆? ?숆린???좏겙?낅땲??'}), 401
    return None


