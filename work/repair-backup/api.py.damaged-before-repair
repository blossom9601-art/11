def _serialize_ticket(row: SvcTicket, include_files: bool = False) -> dict:
    # Parse assignee_json
    assignee_list = _parse_json_safe(getattr(row, 'assignee_json', None), [])
    # Parse target_object as JSON array if possible
    raw_target = row.target_object or ''
    if raw_target.strip().startswith('['):
        target_list = _parse_json_safe(raw_target, [])
    else:
        target_list = [raw_target] if raw_target.strip() else []

    payload = {
        'id': row.id,
        'title': row.title,
        'ticket_type': row.ticket_type,
        'category': row.category,
        'priority': row.priority,
        'status': row.status,
        'requester_user_id': row.requester_user_id,
        'requester_dept_id': row.requester_dept_id,
        'assignee_user_id': row.assignee_user_id,
        'assignee_dept_id': row.assignee_dept_id,
        'assignee_json_raw': getattr(row, 'assignee_json', None),
        'assignee_list': assignee_list,
        'target_object': row.target_object,
        'target_list': target_list,
        'due_at': row.due_at,
        'detail': row.detail,
        'resolved_at': row.resolved_at,
        'closed_at': row.closed_at,
        'resolution_summary': row.resolution_summary,
        'created_at': row.created_at,
        'created_by_user_id': row.created_by_user_id,
        'updated_at': row.updated_at,
        'updated_by_user_id': row.updated_by_user_id,
        'is_deleted': row.is_deleted,
        'cleared': getattr(row, 'cleared', 0) or 0,
        'requester_name': (row.requester.name if getattr(row, 'requester', None) else None),
        'assignee_name': (row.assignee.name if getattr(row, 'assignee', None) else None),
    }
    if include_files:
        payload['files'] = [_serialize_ticket_file(f) for f in (row.files or []) if not (f.is_deleted or 0)]
    else:
        payload['file_count'] = sum(1 for f in (row.files or []) if not (f.is_deleted or 0))
    return payload


