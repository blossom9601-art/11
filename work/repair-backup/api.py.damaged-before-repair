_GOV_TAB_SUFFIXES = ('_detail', '_ip_range', '_manager', '_communication',
                     '_vpn_policy', '_task', '_log', '_file')


def _gov_base_key(k: str) -> str:
    """Strip the governance tab suffix to get the shared session key.

    Examples:
        gov_ip_policy_detail        ??gov_ip_policy
        gov_vpn_policy2_manager     ??gov_vpn_policy2
        gov_dedicatedline_member_file ??gov_dedicatedline_member
    """
    import re as _re
    # IP policy
    m = _re.match(r'^(gov_ip_policy)_', k)
    if m:
        return m.group(1)
    # VPN policy (vpn, vpn2, ..., vpn5)
    m = _re.match(r'^(gov_vpn_policy\d?)_', k)
    if m:
        return m.group(1)
    # Dedicated line
    m = _re.match(r'^(gov_dedicatedline_(?:member|customer|van|affiliate|intranet))_', k)
    if m:
        return m.group(1)
    # Generic fallback
    for suf in _GOV_TAB_SUFFIXES:
        if k.endswith(suf):
            return k[: -len(suf)]
    return k


