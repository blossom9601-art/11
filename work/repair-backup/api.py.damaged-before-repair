    ?ㅽ??쇰쭔 吏곸젒 留ㅽ븨?쒕떎. (Gmail/Outlook/Naver ?명솚)
    """
    import re as _re

    # ?? 0. <style> 釉붾줉?먯꽌 CSS 蹂?섎쭔 異붿텧 ???????????????????
    css_vars = {}
