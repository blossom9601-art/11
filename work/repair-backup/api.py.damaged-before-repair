                db.session.query(UserProfile.id)
                .filter(UserProfile.department_id == dept_id)
                .subquery()
            )

        if view == 'participating':
            if is_team_leader and dept_id and dept_participation is not None:
                # For team leaders: tasks from OTHER departments that reference our dept
                # Exclude tasks that are already owned by same-dept members (those appear in ?대떦)
                own_dept_task = or_(
                    WrkReport.owner_dept_id == dept_id,
                    WrkReport.owner_user_id.in_(db.session.query(same_dept_user_ids.c.id)),
                    WrkReport.created_by_user_id.in_(db.session.query(same_dept_user_ids.c.id)),
                )
                query = query.filter(
                    or_(user_participation, dept_participation),
                    ~own_dept_task,
                )
            elif dept_participation is not None:
                query = query.filter(or_(user_participation, dept_participation))
            else:
                query = query.filter(user_participation)
        elif view == 'other':
            # Tasks where user is NOT owner/creator AND NOT participant
            is_owner = or_(WrkReport.owner_user_id == actor_user_id, WrkReport.created_by_user_id == actor_user_id)
            exclude_conditions = [~is_owner, ~user_participation]
            if dept_participation is not None:
                exclude_conditions.append(~dept_participation)
            query = query.filter(*exclude_conditions)
        elif view == 'all':
            pass  # No ownership filter ??show all reports
        else:
            # view == 'my' (?대떦 ?묒뾽)
            if is_team_leader and dept_id and same_dept_user_ids is not None:
                # Team leaders see all tasks from their department
                query = query.filter(or_(
                    WrkReport.owner_user_id == actor_user_id,
                    WrkReport.created_by_user_id == actor_user_id,
                    WrkReport.owner_dept_id == dept_id,
                    WrkReport.owner_user_id.in_(db.session.query(same_dept_user_ids.c.id)),
                    WrkReport.created_by_user_id.in_(db.session.query(same_dept_user_ids.c.id)),
                ))
            else:
                query = query.filter(or_(WrkReport.owner_user_id == actor_user_id, WrkReport.created_by_user_id == actor_user_id))

        if statuses:
            # Completed tab behavior: ARCHIVED should not show up unless explicitly asked
            query = query.filter(WrkReport.status.in_(statuses))
        else:
            query = query.filter(WrkReport.status != 'ARCHIVED')

        # For my/participating views, hide items cleared by THIS user (per-user 鍮꾩슦湲?
        # ?꾨즺?묒뾽(all/other) views still show all items
        if view in ('my', 'participating'):
            cleared_subq = db.session.query(WrkReportUserClear.report_id).filter(
                WrkReportUserClear.user_id == actor_user_id,
            ).subquery()
            query = query.filter(~WrkReport.id.in_(db.session.query(cleared_subq)))

        rows = query.order_by(WrkReport.start_datetime.desc(), WrkReport.id.desc()).limit(limit).all()

        changed = False
        now_dt = datetime.utcnow()
        for row in rows:
            if _sync_wrk_report_status(row, now=now_dt):
                changed = True
        if changed:
            db.session.commit()

        return jsonify({'success': True, 'items': [_serialize_wrk_report_summary(r) for r in rows], 'total': len(rows)})
    except Exception:
        db.session.rollback()
        logger.exception('Failed to list work reports')
        return jsonify({'success': False, 'message': '?묒뾽蹂닿퀬??紐⑸줉 議고쉶 以??ㅻ쪟媛 諛쒖깮?덉뒿?덈떎.'}), 500


