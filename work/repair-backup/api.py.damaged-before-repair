def _resolve_access_scope(default_scope=None):
    scope = request.args.get('view') or request.args.get('status_scope')
    if not scope and default_scope:
        scope = default_scope
    if not scope:
        return None
    normalized = scope.strip().lower()
    if not normalized or normalized in ('all', 'any', 'none', '?꾩껜'):
        return None
    return normalized


def _collect_access_status_filters():
    collected = []
    for key in ('status', 'statuses', 'statuses[]'):
        for raw in request.args.getlist(key):
            token = raw.strip()
            if token and token not in collected:
                collected.append(token)
    return collected


