def _resolve_tab61_contract_pk(scope: str, cost_type: str, contract_ref, *, strict: bool) -> int:
    """Resolve tab61 contract reference to an internal numeric PK.

    The tab61 frontend passes 愿由щ쾲??contract_code) as `contract_id` to avoid exposing
    numeric DB identifiers in the browser URL. For backward compatibility, we still
    accept numeric IDs too.
    """

    raw = '' if contract_ref is None else str(contract_ref).strip()
    if not raw:
        return 0

    # NOTE:
    # contract_code(愿由щ쾲?? can be numeric-like (e.g. "1111"). In that case,
    # treating it as an integer ID would incorrectly bypass the contract_code lookup
    # and store an orphan contract_id. Always attempt contract_code lookup first.
    int_candidate = None
    try:
        int_candidate = int(raw)
    except (TypeError, ValueError):
        int_candidate = None

    scope_u = (scope or '').strip().upper()
    cost_type_u = (cost_type or '').strip().upper()

    record = None
    try:
        if scope_u == 'OPEX':
            record = svc_get_opex_contract_by_manage_no(raw, opex_type=cost_type_u) or svc_get_opex_contract_by_manage_no(raw)
        elif scope_u == 'CAPEX':
            record = svc_get_capex_contract_by_manage_no(raw, capex_type=cost_type_u) or svc_get_capex_contract_by_manage_no(raw)
        else:
            record = (
                svc_get_opex_contract_by_manage_no(raw, opex_type=cost_type_u)
                or svc_get_opex_contract_by_manage_no(raw)
                or svc_get_capex_contract_by_manage_no(raw, capex_type=cost_type_u)
                or svc_get_capex_contract_by_manage_no(raw)
            )
    except Exception:
        record = None

    resolved = None
    if isinstance(record, dict):
        resolved = record.get('id')
    if resolved not in (None, ''):
        try:
            return int(resolved)
        except (TypeError, ValueError):
            pass

    # Backward compatibility: accept numeric identifiers only when they resolve to an
    # existing contract row.
    if int_candidate is not None and int_candidate > 0:
        try:
            if scope_u == 'OPEX':
                by_id = svc_get_opex_contract(int_candidate)
            elif scope_u == 'CAPEX':
                by_id = svc_get_capex_contract(int_candidate)
            else:
                by_id = svc_get_opex_contract(int_candidate) or svc_get_capex_contract(int_candidate)
            if by_id:
                return int_candidate
        except Exception:
            pass

    if strict:
        raise ValueError('contract_id 媛믪씠 ?щ컮瑜댁? ?딆뒿?덈떎.')
    return 0


