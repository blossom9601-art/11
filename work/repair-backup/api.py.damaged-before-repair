            row.content_type = content_type
            row.is_deleted = 0
            row.updated_at = now
            row.updated_by_user_id = actor_user_id
        else:
            row = NetLeasedLineDiagram(
                line_id=line_id,
                file_path=rel_path,
                original_name=original_name,
                file_size=int(actual_size) if actual_size is not None else None,
