def _work_status_dot_cls(status_name: str, status_level: str) -> str:
    """Return the CSS dot class from status_level (DB), falling back to name-based mapping."""
    lvl = (status_level or '').strip()
    if lvl:
        return lvl
    s = (status_name or '').strip()
    if s in ('active', 'running'): return 'ws-run'
    if s in ('holiday',): return 'ws-c3'
    if s in ('standby', 'waiting'): return 'ws-c1'
    if s in ('hold',): return 'ws-c5'
    if s in ('dispatch_wait',): return 'ws-c8'
    return 'ws-c10'  # ?湲?etc.


