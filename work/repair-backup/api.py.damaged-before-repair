def _hardware_asset_names_by_ids(ids: Sequence[int]) -> Dict[int, str]:
    ids = [int(x) for x in ids if x is not None]
    if not ids:
        return {}
    try:
        rows = db.session.execute(
            text(
                """
                SELECT id, asset_name
                FROM hardware_asset
                WHERE id IN :ids
                """
            ),
            {'ids': tuple(ids)},
        ).fetchall()
        out: Dict[int, str] = {}
        for r in rows:
            try:
                out[int(r[0])] = str(r[1] or '').strip()
            except Exception:
                continue
        if out:
            return out
        # If the table exists but doesn't have the row(s), try service fallback.
        try:
            return _hardware_asset_names_by_ids_service(ids)
        except Exception:
            return {}
    except Exception:
        # Best-effort (hardware_asset may not exist in some environments)
        try:
            return _hardware_asset_names_by_ids_service(ids)
        except Exception:
            return {}


def _hardware_asset_names_by_ids_service(ids: Sequence[int]) -> Dict[int, str]:
    """Best-effort name lookup via hardware_asset_service (hardware_asset.db).

    This is used when the ORM DB does not have a hardware_asset table.
    """

    out: Dict[int, str] = {}
    for raw in ids or []:
        try:
            aid = int(raw)
        except Exception:
            continue
        if aid <= 0 or aid in out:
            continue
        try:
            item = svc_get_hardware_asset(aid, asset_category='STORAGE')
            name = str((item or {}).get('asset_name') or '').strip()
            if name:
                out[aid] = name
        except Exception:
            continue
    return out


def _hw_asset_name_map(ids: Sequence[int]) -> Dict[int, str]:
    """Resolve hardware asset names from either ORM DB or service DB."""
    ids_int = []
    for x in ids or []:
        try:
            ids_int.append(int(x))
        except Exception:
            continue
    orm_map = _hardware_asset_names_by_ids(ids_int)
    if orm_map:
        return orm_map
    return _hardware_asset_names_by_ids_service(ids_int)


