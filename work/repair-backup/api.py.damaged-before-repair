@api_bp.route('/api/release-notes', methods=['GET'])
def get_release_notes():
    """release-notes.md 瑜??뚯떛?섏뿬 援ъ“?붾맂 由대━利??명듃瑜?諛섑솚?쒕떎."""
    base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
    rn_path = os.path.join(base_dir, 'release-notes.md')
    v_path = os.path.join(base_dir, 'version.json')

    current_version = ''
    try:
        with open(v_path, 'r', encoding='utf-8') as f:
            current_version = 'v' + json.load(f).get('version', '')
    except Exception:
        pass

    try:
        with open(rn_path, 'r', encoding='utf-8') as f:
            content = f.read()
    except FileNotFoundError:
        return jsonify({'notes': [], 'current_version': current_version})
    except Exception:
        logger.exception('Failed to read release-notes.md')
        return jsonify({'error': 'release notes read failed'}), 500

    notes = []
    current_note = None
    for line in content.split('\n'):
        stripped = line.strip()
        if stripped.startswith('# '):
            if current_note:
                notes.append(current_note)
            current_note = {'version': stripped[2:].strip(), 'items': []}
        elif stripped.startswith('- ') and current_note is not None:
            current_note['items'].append(stripped[2:].strip())
    if current_note:
        notes.append(current_note)

    return jsonify({'notes': notes, 'current_version': current_version})


@api_bp.route('/api/version', methods=['PUT'])
def update_version():
    """version.json ???쒖뒪??踰꾩쟾 ?뺣낫瑜??섏젙?쒕떎."""
    base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
    vpath = os.path.join(base_dir, 'version.json')
    data = request.get_json(silent=True)
    if not data:
        return jsonify({'success': False, 'error': '?붿껌 ?곗씠?곌? ?놁뒿?덈떎.'}), 400

    allowed_keys = {'version', 'build', 'release_date', 'environment'}
    payload = {}
    for k in allowed_keys:
        if k in data:
            payload[k] = str(data[k]).strip()

    if not payload:
        return jsonify({'success': False, 'error': '?섏젙????ぉ???놁뒿?덈떎.'}), 400

    try:
        existing = {}
        if os.path.exists(vpath):
            with open(vpath, 'r', encoding='utf-8') as f:
                existing = json.load(f)
        before = dict(existing)
        existing.update(payload)
        with open(vpath, 'w', encoding='utf-8', newline='\n') as f:
            json.dump(existing, f, ensure_ascii=False, indent=2)
        for k in payload.keys():
            _settings_log_api('踰꾩쟾愿由?, k, before.get(k), existing.get(k))
        return jsonify({'success': True, 'item': existing})
    except Exception:
        logger.exception('Failed to update version.json')
        return jsonify({'success': False, 'error': '踰꾩쟾 ?뺣낫 ????ㅽ뙣'}), 500


