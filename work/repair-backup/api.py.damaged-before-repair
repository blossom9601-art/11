_DR_TRAINING_ALLOWED_STATUS = {'?꾨즺', '?덉젙', '蹂대쪟'}
_DR_TRAINING_ALLOWED_TYPES = {'?먯껜 紐⑥쓽?덈젴', '?⑸룞 紐⑥쓽?덈젴', '?곕룞 紐⑥쓽?덈젴'}
_DR_TRAINING_ALLOWED_RESULTS = {'success', 'partial_success', 'failure', 'cancelled'}


def _parse_recovery_time(value: Optional[str]) -> tuple[Optional[int], Optional[str]]:
    """Parse Korean recovery time text into minutes (best-effort).

    Examples:
    - '2?쒓컙' -> 120
    - '1?쒓컙 30遺? -> 90
    - '90遺? -> 90
    - '120' -> 120 (minutes)
    """

    raw = (value or '').strip()
    if not raw:
        return None, None
    text_val = raw

    token = raw.replace(' ', '')
    # digits only -> minutes
    if re.fullmatch(r'\d+', token):
        try:
            mins = int(token)
        except Exception:
            mins = None
        else:
            if mins < 0:
                mins = None
        return mins, text_val[:50]

    # e.g. 1?쒓컙30遺?/ 1?쒓컙
    m = re.fullmatch(r'(?:(\d+)?쒓컙)?(?:(\d+)遺??', token)
    if m:
        h = m.group(1)
        mm = m.group(2)
        try:
            hours = int(h) if h is not None else 0
            minutes = int(mm) if mm is not None else 0
        except Exception:
            return None, text_val[:50]
        total = hours * 60 + minutes
        if total <= 0:
            # allow text but no numeric
            return None, text_val[:50]
        return total, text_val[:50]

    # fallback: store text only
    return None, text_val[:50]


