@api_bp.route('/api/hardware/assets', methods=['GET'])
def list_hardware_assets_by_category():
    """Consolidated hardware asset list endpoint for selection UIs.

    Requires asset_category (SERVER/STORAGE/SAN/NETWORK/SECURITY).
    Optionally accepts asset_type; when omitted, returns all types in the category.
    Supports q/page/page_size and the same work_* code filters as other endpoints.
    """
    asset_category = (request.args.get('asset_category') or request.args.get('category') or '').strip().upper()
    # When rack_code is provided, allow omitting asset_category to fetch all categories
    rack_code_param = (request.args.get('rack_code') or '').strip()
    if not asset_category and not rack_code_param:
        return jsonify({'success': False, 'message': 'asset_category ?뚮씪誘명꽣媛 ?꾩슂?⑸땲??'}), 400
    allowed = {'SERVER', 'STORAGE', 'SAN', 'NETWORK', 'SECURITY'}
    if asset_category and asset_category not in allowed:
        return jsonify({'success': False, 'message': '吏?먰븯吏 ?딅뒗 ?먯궛 援щ텇?낅땲??'}), 400

    # asset_type can be a single token (e.g., ON_PREMISE) or a comma-separated list
    # (e.g., ON_PREMISE,CLOUD,WORKSTATION). Also accept repeated query params.
    asset_type_tokens: List[str] = []
    try:
        raw_list = []
        raw_list.extend(request.args.getlist('asset_type') or [])
        raw_list.extend(request.args.getlist('assetType') or [])
        if not raw_list:
            raw = (request.args.get('asset_type') or '').strip()
            if raw:
                raw_list = [raw]
        for raw_item in raw_list:
            for token in str(raw_item or '').split(','):
                t = token.strip().upper()
                if t:
                    asset_type_tokens.append(t)
    except Exception:
        asset_type_tokens = []

    asset_type: Optional[Union[str, Sequence[str]]]
    if not asset_type_tokens:
        asset_type = None
    else:
        # De-duplicate while preserving order.
        seen: Set[str] = set()
        unique_tokens: List[str] = []
        for t in asset_type_tokens:
            if t in seen:
                continue
            seen.add(t)
            unique_tokens.append(t)
        asset_type = unique_tokens[0] if len(unique_tokens) == 1 else unique_tokens
    search = (request.args.get('q') or '').strip() or None
    page = request.args.get('page', default=1, type=int) or 1
    page_size = request.args.get('page_size', default=50, type=int) or 50
    filters = _hardware_asset_filters_from_request()
    try:
        result = svc_list_hardware_assets(
            search=search,
            filters=filters,
            page=page,
            page_size=page_size,
            asset_category=asset_category or None,
            asset_type=asset_type,
        )
        _attach_linked_agent_info(result.get('items') or [])
        return jsonify({'success': True, **result})
    except Exception:
        logger.exception('Failed to fetch hardware assets asset_category=%s asset_type=%s', asset_category, asset_type)
        return jsonify({'success': False, 'message': '?섎뱶?⑥뼱 ?먯궛 紐⑸줉 議고쉶 以??ㅻ쪟媛 諛쒖깮?덉뒿?덈떎.'}), 500


