def _parse_release_blocks(content):
    """release-notes.md ?댁슜??[{version, items}] 釉붾줉 由ъ뒪?몃줈 ?뚯떛?쒕떎."""
    blocks = []
    current = None
    for line in content.split('\n'):
        stripped = line.strip()
        if stripped.startswith('# '):
            if current:
                blocks.append(current)
            current = {'version': stripped[2:].strip(), 'items': []}
        elif stripped.startswith('- ') and current is not None:
            current['items'].append(stripped[2:].strip())
    if current:
        blocks.append(current)
    return blocks


def _blocks_to_md(blocks):
    """釉붾줉 由ъ뒪?몃? release-notes.md ?뺤떇 臾몄옄?대줈 蹂?섑븳??"""
    parts = []
    for b in blocks:
        section = '# ' + b['version'] + '\n'
        for item in b['items']:
            section += '- ' + item + '\n'
        parts.append(section)
    return '\n'.join(parts)


