def _wrk_normalize_dt(dt: Optional[datetime]) -> Optional[datetime]:
    if not dt:
        return None
    if getattr(dt, 'tzinfo', None) is None:
        return dt
    try:
        return dt.astimezone(timezone.utc).replace(tzinfo=None)
    except Exception:
        return dt.replace(tzinfo=None)


