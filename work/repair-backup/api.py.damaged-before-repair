@api_bp.route('/api/work-groups/<int:group_id>/files', methods=['POST'])
def upload_work_group_files(group_id: int):
    actor_user_id = _coerce_positive_int(_resolve_actor_user_id())
    if not actor_user_id:
        return jsonify({'success': False, 'message': '?ъ슜???몄뀡??留뚮즺?섏뿀?듬땲??'}), 401

    kind = (request.args.get('kind') or '').strip().lower() or 'attachment'
    if kind not in ('attachment', 'diagram'):
        return jsonify({'success': False, 'message': '吏?먰븯吏 ?딅뒗 kind ?낅땲??'}), 400

    try:
        wg = svc_get_work_group(group_id)
        if not wg:
            return jsonify({'success': False, 'message': '??곸쓣 李얠쓣 ???놁뒿?덈떎.'}), 404

        files = []
        try:
            files.extend(request.files.getlist('files'))
        except Exception:
            pass
        try:
            files.extend(request.files.getlist('attachments'))
        except Exception:
            pass
        files = [f for f in files if f and getattr(f, 'filename', None)]
        if not files:
            return jsonify({'success': False, 'message': '泥⑤? ?뚯씪???놁뒿?덈떎.'}), 400
        if kind == 'diagram' and len(files) != 1:
            return jsonify({'success': False, 'message': '???援ъ꽦?꾨뒗 1媛??뚯씪留??낅줈?쒗븷 ???덉뒿?덈떎.'}), 400
        if kind == 'attachment' and len(files) > 5:
            return jsonify({'success': False, 'message': '泥⑤? ?뚯씪? 理쒕? 5媛쒓퉴吏 ?낅줈?쒗븷 ???덉뒿?덈떎.'}), 400

        # When setting a new diagram, purge previous diagram rows (disk cleanup best-effort)
        if kind == 'diagram':
            try:
                old = svc_purge_work_group_file_kind(group_id, 'diagram')
                folder = _wg_upload_folder(group_id)
                for r in old:
                    stored = os.path.basename((r.get('stored_name') or '').replace('\\', '/'))
                    if stored:
                        abs_path = os.path.join(folder, stored)
                        if os.path.exists(abs_path):
                            try:
                                os.remove(abs_path)
                            except OSError:
                                pass
            except Exception:
                pass

        folder = _wg_upload_folder(group_id)
        os.makedirs(folder, exist_ok=True)

        created = []
        max_bytes = 10 * 1024 * 1024 if kind == 'attachment' else 20 * 1024 * 1024
        for file in files:
            original = (file.filename or '').strip()
            safe = secure_filename(original)
            if not safe:
                continue
            if not _is_allowed_upload_file(safe):
                return jsonify({'success': False, 'message': f'?덉슜?섏? ?딅뒗 ?뚯씪 ?뺤떇?낅땲?? {safe}'}), 400
            stored = svc_new_wg_stored_filename(safe)
            abs_path = os.path.join(folder, stored)
            file.save(abs_path)

            try:
                size_bytes = os.path.getsize(abs_path)
            except OSError:
                size_bytes = None
            if size_bytes is not None and size_bytes > max_bytes:
                try:
                    os.remove(abs_path)
                except OSError:
                    pass
                return jsonify({'success': False, 'message': '?뚯씪 ?⑸웾 ?쒗븳??珥덇낵?덉뒿?덈떎.'}), 400

            rec = svc_create_work_group_file(
                group_id,
                kind=kind,
                stored_name=stored,
                original_name=original,
                content_type=getattr(file, 'mimetype', None),
                size_bytes=size_bytes,
                actor=_resolve_actor(),
            )
            rec['download_url'] = f"/api/work-groups/{group_id}/files/{rec['id']}/download"
            created.append(rec)

        for c in created:
            _try_record_wg_change(
                action_type='CREATE', group_id=group_id,
                tab_name='援ъ꽦/?뚯씪', new_data=c,
                summary='?뚯씪 ?낅줈?? ' + (c.get('original_name') or ''),
            )
        return jsonify({'success': True, 'items': created}), 201
    except Exception:
        logger.exception('Failed to upload work group files id=%s', group_id)
        return jsonify({'success': False, 'message': '?뚯씪 ?낅줈??以??ㅻ쪟媛 諛쒖깮?덉뒿?덈떎.'}), 500


