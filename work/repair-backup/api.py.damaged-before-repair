def _ensure_wrk_report_doc_no(row: WrkReport, actor_user_id: int) -> None:
    """?뱀씤 ?쒖젏??臾몄꽌踰덊샇媛 鍮꾩뼱?덈떎硫??먮룞 諛쒕쾲.

    Format: TSK-{YYYY}-{00001}
    Sequence scope: ?곕룄 湲곗? 湲濡쒕쾶
    """
    if row.doc_no and str(row.doc_no).strip():
        return

    year = datetime.now().year
    prefix = f"TSK-{year}-"

    last_doc_no = None
    try:
        last_row = (
            db.session.query(WrkReport.doc_no)
            .filter(WrkReport.doc_no.like(f"{prefix}%"))
            .order_by(WrkReport.doc_no.desc(), WrkReport.id.desc())
            .first()
        )
        last_doc_no = last_row[0] if last_row else None
    except Exception:
        last_doc_no = None

    seq = 1
    if last_doc_no:
        m = re.match(rf"^TSK-{year}-(\d{{5}})$", str(last_doc_no))
        if m:
            try:
                seq = int(m.group(1)) + 1
            except Exception:
                seq = 1

    # Avoid collisions (including concurrent approvals) by checking existence.
    for _ in range(0, 50):
        candidate = f"TSK-{year}-{seq:05d}"
        exists = db.session.query(WrkReport.id).filter(WrkReport.doc_no == candidate).first()
        if not exists:
            row.doc_no = candidate
            return
        seq += 1

    raise RuntimeError('Failed to allocate unique doc_no for work report')


def _sync_wrk_report_status(row: WrkReport, now: Optional[datetime] = None) -> bool:
    """Auto-transition status based on current time and start_datetime.

    - APPROVED: within [start-2d, start) => SCHEDULED
    - APPROVED/SCHEDULED: now >= start => IN_PROGRESS
    """
    if not row or row.is_deleted:
        return False

    now_dt = _wrk_normalize_dt(now or datetime.utcnow())
    start_dt = _wrk_normalize_dt(row.start_datetime)
    if not start_dt:
        return False

    if row.status in ('APPROVED', 'SCHEDULED'):
        if now_dt >= start_dt and row.status != 'IN_PROGRESS':
            row.status = 'IN_PROGRESS'
            row.updated_at = now_dt
            return True

    if row.status == 'APPROVED':
        threshold = start_dt - timedelta(days=2)
        if threshold <= now_dt < start_dt:
            row.status = 'SCHEDULED'
            row.updated_at = now_dt
            return True

    return False


